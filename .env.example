# NIGHTSHIFT configuration  (chmod 600 — contains the ntfy topic and command secret)

# --- Notifications -----------------------------------------------------------
# Subscribe on your phone to BOTH topics in the ntfy app:
#   ns-od8z79qwlony5ed465585kyq5603y        <- alerts, digests, task results
#   ns-od8z79qwlony5ed465585kyq5603y-cmd    <- you send commands here
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=<generated>
# Every command must start with this secret, e.g.  "RERsNk: pause"
CMD_SECRET=<generated>

# --- Dead-man's switch -------------------------------------------------------
# Create a check at https://healthchecks.io (period 15m, grace 15m) and paste its ping URL.
HC_PING_URL=

# --- Timezone ----------------------------------------------------------------
TZ=Europe/Berlin

# --- Pinned versions (nothing auto-updates while Tim is away) ----------------
NS_DIND_IMAGE=docker:29.7.2-dind@sha256:12e683a161823b2a839aeea999b9d960e6e1f9a97b1679ad6b441982e2d9cf07
NS_PYTHON_IMAGE=python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9
NS_NODE_IMAGE=node:22-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9
NS_SQUID_IMAGE=ubuntu/squid@sha256:6a097f68bae708cedbabd6188d68c7e2e7a38cedd05a176e1cc0ba29e3bbe029
NS_CLAUDE_CODE_VERSION=2.1.278
NS_AGENT_IMAGE_TAG=nightshift-agent:2.1.278-1

# --- Debug / dry-run flags (must be unset before arming) ---------------------
NS_FAKE_LIMIT=0
